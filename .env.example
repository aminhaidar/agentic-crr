# Operator conversation backend.
#
# Leave VITE_OPERATOR_AGENT_URL unset to run the composer against the offline
# MockOperatorAgent (no backend required). Set it to a running ml-agent-service
# to talk to the real Reporting Operator stored agent.
#
# Local ml-agent-service: `make start && make wait` in the ml-agent-service repo
# (server on :5050). Auth validation is bypassed locally, but the identity
# headers below are still required by the stored-agent route.

# VITE_OPERATOR_AGENT_URL=http://localhost:5050
# VITE_OPERATOR_AGENT_NAME=reporting-operator-agent
# VITE_OPERATOR_AGENT_SCOPE=agentic-crr

# Workiva identity headers (workspace id, org id, user id).
# VITE_WORKIVA_ACCOUNT_RID=
# VITE_WORKIVA_ORGANIZATION=
# VITE_WORKIVA_USER_RID=
